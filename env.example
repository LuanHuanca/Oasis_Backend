# Configuración de Base de Datos PostgreSQL
POSTGRES_DB=oasis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# Configuración del Backend
BACKEND_PORT=9999

# Configuración del Frontend (cuando esté disponible)
FRONTEND_PORT=3000

# Configuración de Email (Gmail SMTP)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=tu-email@gmail.com
SPRING_MAIL_PASSWORD=tu-app-password

# Configuración de Google Generative AI
GOOGLE_GENERATIVEAI_API_KEY=tu-api-key-aqui

