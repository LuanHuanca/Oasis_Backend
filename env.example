# ============================================
# CONFIGURACIÓN PARA RAILWAY
# ============================================

# Configuración de Base de Datos PostgreSQL (Railway proporciona estas variables)
# Railway automáticamente provee: ${{Postgres.PGHOST}}, ${{Postgres.PGPORT}}, etc.
# Usa estas variables en Railway Dashboard → Variables

SPRING_DATASOURCE_URL=jdbc:postgresql://${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
SPRING_DATASOURCE_USERNAME=${{Postgres.PGUSER}}
SPRING_DATASOURCE_PASSWORD=${{Postgres.PGPASSWORD}}

# O si prefieres usar las variables directas de Railway:
# SPRING_DATASOURCE_URL=jdbc:postgresql://${PGHOST}:${PGPORT}/${PGDATABASE}
# SPRING_DATASOURCE_USERNAME=${PGUSER}
# SPRING_DATASOURCE_PASSWORD=${PGPASSWORD}

# Configuración del Backend
SERVER_PORT=${PORT:-9999}

# Configuración de Email (Gmail SMTP)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=tu-email@gmail.com
SPRING_MAIL_PASSWORD=tu-app-password

# Configuración de Google Generative AI
GOOGLE_GENERATIVEAI_API_KEY=tu-api-key-aqui

# Configuración de CORS (IMPORTANTE: Usa la URL de tu frontend en Railway)
# Puedes usar "*" para permitir cualquier origen, o la URL específica del frontend
# Ejemplo con URL específica: https://tu-frontend.railway.app
# Ejemplo con múltiples: https://tu-frontend.railway.app,https://tu-dominio.com
CORS_ALLOWED_ORIGINS=*

# ============================================
# NOTAS IMPORTANTES:
# ============================================
# 1. En Railway, NO necesitas crear un archivo .env
# 2. Configura estas variables en: Railway Dashboard → Tu Servicio → Variables
# 3. Para la BD: Railway conecta automáticamente el servicio Postgres y proporciona variables
# 4. Para CORS: Cambia "*" por la URL real de tu frontend cuando esté desplegado
